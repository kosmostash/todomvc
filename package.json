{
  "name": "kosmo-todomvc",
  "version": "1.0.0",
  "description": "TodoMVC built with KosmoJS - React + Hono, todos persisted in SQLite",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "distDir": "dist",
  "devPort": 4556,
  "previewPort": 4558,
  "scripts": {
    "dev": "kosmo serve",
    "preview": "kosmo preview",
    "build": "kosmo build",
    "typecheck": "tsc -p tsconfig.json && kosmo typecheck",
    "folder": "kosmo folder",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@kosmojs/core": "^0.5.0",
    "hono": "^4.13.7",
    "light-my-request": "^6.6.0",
    "path-to-regexp": "^8.4.2",
    "react": "^19.3.0",
    "react-router": "^8.3.1",
    "tinyglobby": "^0.2.17",
    "todomvc-app-css": "^2.4.3",
    "typebox": "^1.3.30"
  },
  "devDependencies": {
    "@kosmojs/cli": "^0.5.0",
    "@kosmojs/dev": "^0.5.0",
    "@playwright/test": "1.56.1",
    "@types/bun": "^1.4.2",
    "@types/deno": "^2.7.0",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
